# ------------------------------------------------------------------
# Borra2 · Variables de entorno
# Copia este archivo como .env.local y llena los valores.
# .env.local NUNCA se sube a GitHub (está en .gitignore).
# ------------------------------------------------------------------

# --- Configuración web de Firebase (pública: va al navegador) ---
# Consola de Firebase → Configuración del proyecto → Tus apps → App web.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# URL pública de la app (para los enlaces de los correos y el SEO).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# App Check con reCAPTCHA v3: clave del sitio (pública).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# true = usar los emuladores locales de Firebase (desarrollo).
NEXT_PUBLIC_USE_EMULATORS=false

# --- Solo servidor (SECRETAS: nunca con prefijo NEXT_PUBLIC_) ---
# Cuenta de servicio de Firebase en base64 (Configuración → Cuentas de servicio → Generar clave).
FIREBASE_SERVICE_ACCOUNT_BASE64=

# true = la API rechaza peticiones sin un token válido de App Check.
APP_CHECK_ENFORCE=false

# --- Fotos de los locales (Cloudinary, plan gratis) ---
# cloudinary.com → Dashboard. Sin estas variables, la subida de fotos queda desactivada.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
