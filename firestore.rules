rules_version = '2';

// Borra2 · Security Rules de Firestore
// Regla general: todo está cerrado salvo lo que se abre explícitamente aquí.
// Los roles salen de los custom claims del token (solo el servidor puede asignarlos).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funciones de ayuda ----------
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isVerified() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.get('role', '') == 'admin';
    }
    // Solo cambian las claves indicadas (el resto queda igual).
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }
    function validGenres(list) {
      return list is list && list.size() <= 10;
    }

    // ---------- Perfiles: users/{uid} ----------
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // Al registrarse: solo campos permitidos y siempre con rol "user".
      // Así nadie puede crearse como admin o como dueño de un local.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
             ['displayName', 'email', 'photoURL', 'role', 'venueId', 'favoriteGenres', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(
             ['displayName', 'email', 'role', 'venueId', 'favoriteGenres', 'createdAt', 'updatedAt'])
        && isText(request.resource.data.displayName, 1, 40)
        && request.resource.data.email == request.auth.token.email
        && (request.resource.data.photoURL == null || isText(request.resource.data.photoURL, 1, 500))
        && request.resource.data.role == 'user'
        && request.resource.data.venueId == null
        && validGenres(request.resource.data.favoriteGenres)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // La persona solo puede cambiar su nombre, foto y géneros favoritos. Nunca su rol.
      allow update: if isOwner(uid)
        && onlyChanges(['displayName', 'photoURL', 'favoriteGenres', 'updatedAt'])
        && isText(request.resource.data.displayName, 1, 40)
        && (request.resource.data.photoURL == null || isText(request.resource.data.photoURL, 1, 500))
        && validGenres(request.resource.data.favoriteGenres)
        && request.resource.data.updatedAt == request.time;

      // Borrar el perfil solo lo hace el servidor (al eliminar la cuenta).
      allow delete: if false;
    }

    // ---------- Todo lo demás: cerrado ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
