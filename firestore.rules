rules_version = '2';

// =====================================================================
// Borra2 · Security Rules de Firestore
// ---------------------------------------------------------------------
// Principios:
// 1. Todo está cerrado salvo lo que se abre explícitamente aquí.
// 2. Los roles salen de los custom claims del token; solo el servidor
//    (Admin SDK en las rutas de API) puede asignarlos.
// 3. Lo que necesita cálculos o validaciones fuertes (reportes, reseñas,
//    semáforo, calificación, roles, crear locales) lo escribe SOLO el
//    servidor. El Admin SDK no pasa por estas reglas.
// 4. Cada escritura del cliente valida claves permitidas, tipos y tamaños.
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funciones de ayuda ----------
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isVerified() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    function role() {
      return signedIn() ? request.auth.token.get('role', 'user') : 'anon';
    }
    function isAdmin() {
      return role() == 'admin';
    }
    // Dueño aprobado de ESE local (claim venueId).
    function managesVenue(venueId) {
      return isVerified() && role() == 'venue' && request.auth.token.get('venueId', '') == venueId;
    }
    function data() {
      return request.resource.data;
    }
    function onlyChanges(keys) {
      return data().diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }
    function isPrice(value) {
      return value is int && value >= 0 && value <= 1000000;
    }
    function validGenres(list) {
      return list is list && list.size() >= 1 && list.size() <= 4
        && list.hasOnly(['Reggaetón', 'Vallenato', 'Champeta', 'Salsa', 'Crossover', 'Electrónica']);
    }
    function validDay(day) {
      return day == null || (day.keys().hasOnly(['open', 'close'])
        && day.open is string && day.open.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && day.close is string && day.close.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'));
    }
    function validSchedule(s) {
      return s is map && s.keys().hasOnly(['lun', 'mar', 'mie', 'jue', 'vie', 'sab', 'dom'])
        && s.keys().hasAll(['lun', 'mar', 'mie', 'jue', 'vie', 'sab', 'dom'])
        && validDay(s.lun) && validDay(s.mar) && validDay(s.mie) && validDay(s.jue)
        && validDay(s.vie) && validDay(s.sab) && validDay(s.dom);
    }
    function validPhotos(list) {
      return list is list && list.size() <= 6;
    }

    // ---------- Configuración global: settings/app ----------
    match /settings/{docId} {
      allow read: if true;
      // El admin solo cambia el interruptor del modo demo (el resto lo maneja el servidor).
      allow create: if isAdmin() && docId == 'app'
        && data().keys().hasOnly(['demoMode', 'updatedAt'])
        && data().demoMode is bool
        && data().updatedAt == request.time;
      allow update: if isAdmin() && docId == 'app'
        && onlyChanges(['demoMode', 'updatedAt'])
        && data().demoMode is bool
        && data().updatedAt == request.time;
      allow delete: if false;
    }

    // ---------- Perfiles: users/{uid} ----------
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // Al registrarse: solo campos permitidos y siempre con rol "user".
      allow create: if isOwner(uid)
        && data().keys().hasOnly(
             ['displayName', 'email', 'photoURL', 'role', 'venueId', 'favoriteGenres', 'createdAt', 'updatedAt'])
        && data().keys().hasAll(
             ['displayName', 'email', 'role', 'venueId', 'favoriteGenres', 'createdAt', 'updatedAt'])
        && isText(data().displayName, 1, 40)
        && data().email == request.auth.token.email
        && (data().get('photoURL', null) == null || isText(data().photoURL, 1, 500))
        && data().role == 'user'
        && data().venueId == null
        && data().favoriteGenres is list && data().favoriteGenres.size() <= 10
        && data().createdAt == request.time
        && data().updatedAt == request.time;

      // Solo su nombre, foto y géneros favoritos. Nunca el rol ni el local.
      allow update: if isOwner(uid)
        && onlyChanges(['displayName', 'photoURL', 'favoriteGenres', 'updatedAt'])
        && isText(data().displayName, 1, 40)
        && (data().get('photoURL', null) == null || isText(data().photoURL, 1, 500))
        && data().favoriteGenres is list && data().favoriteGenres.size() <= 10
        && data().updatedAt == request.time;

      allow delete: if false;

      // Favoritos: users/{uid}/favorites/{venueId}
      match /favorites/{venueId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isVerified()
          && data().keys().hasOnly(['venueName', 'createdAt'])
          && isText(data().venueName, 1, 60)
          && data().createdAt == request.time
          && exists(/databases/$(database)/documents/venues/$(venueId));
        allow delete: if isOwner(uid);
        allow update: if false;
      }
    }

    // ---------- Locales: venues/{venueId} ----------
    match /venues/{venueId} {
      // Los locales activos son públicos (mapa y fichas sin cuenta).
      allow get: if resource.data.status == 'active' || isAdmin() || managesVenue(venueId);
      // Las consultas públicas DEBEN filtrar por status == 'active' y llevar límite.
      allow list: if (resource.data.status == 'active' && request.query.limit <= 100) || isAdmin();

      // Crear, ocultar o borrar locales, el semáforo y la calificación: solo el servidor.
      allow create, delete: if false;

      // El dueño aprobado edita solo los datos de su vitrina.
      allow update: if managesVenue(venueId)
        && onlyChanges(['coverPrice', 'drinkPriceFrom', 'genres', 'schedule', 'description',
                        'ambience', 'dressCode', 'photos', 'updatedAt'])
        && isPrice(data().coverPrice)
        && isPrice(data().drinkPriceFrom)
        && validGenres(data().genres)
        && validSchedule(data().schedule)
        && isText(data().description, 10, 400)
        && isText(data().ambience, 0, 120)
        && isText(data().dressCode, 0, 60)
        && validPhotos(data().photos)
        && data().updatedAt == request.time;

      // Reportes: privados (tienen el uid). Los lee el dueño del local o un admin.
      match /reports/{reportId} {
        allow read: if managesVenue(venueId) || isAdmin();
        allow write: if false;
      }

      // Reseñas: públicas. Se escriben por la API para recalcular la calificación.
      match /reviews/{reviewUid} {
        allow read: if true;
        allow write: if false;
      }

      // Promociones: públicas si están activas; las gestiona el dueño o un admin.
      match /promos/{promoId} {
        allow read: if resource.data.active == true || managesVenue(venueId) || isAdmin();

        function validPromo() {
          return data().keys().hasOnly(['title', 'detail', 'active', 'startsAt', 'endsAt', 'createdAt', 'updatedAt'])
            && isText(data().title, 3, 80)
            && isText(data().detail, 0, 160)
            && data().active is bool
            && (data().startsAt == null || data().startsAt is timestamp)
            && (data().endsAt == null || data().endsAt is timestamp)
            && data().updatedAt == request.time;
        }

        allow create: if (managesVenue(venueId) || isAdmin()) && validPromo()
          && data().createdAt == request.time;
        allow update: if (managesVenue(venueId) || isAdmin()) && validPromo()
          && data().createdAt == resource.data.createdAt;
        allow delete: if managesVenue(venueId) || isAdmin();
      }
    }

    // ---------- Solicitudes para administrar un local ----------
    match /venueClaims/{claimId} {
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();

      // Cualquiera verificado puede pedirlo, siempre como "pendiente".
      allow create: if isVerified()
        && data().keys().hasOnly(['uid', 'venueId', 'applicantName', 'phone', 'message', 'status',
                                  'reviewedBy', 'createdAt', 'updatedAt'])
        && data().uid == request.auth.uid
        && isText(data().venueId, 1, 40)
        && exists(/databases/$(database)/documents/venues/$(data().venueId))
        && isText(data().applicantName, 3, 60)
        && data().phone is string && data().phone.matches('^[+]?[0-9][0-9 -]{6,18}$')
        && isText(data().message, 10, 400)
        && data().status == 'pending'
        && data().reviewedBy == null
        && data().createdAt == request.time
        && data().updatedAt == request.time;

      // Aprobar o rechazar asigna roles: solo el servidor.
      allow update, delete: if false;
    }

    // ---------- Ubicaciones compartidas ----------
    match /sharedLocations/{token} {
      // Quien tenga el enlace puede verla; nadie puede listarlas todas.
      allow get: if true;
      allow list: if false;

      function validLocation() {
        return data().location is latlng;
      }

      allow create: if isVerified()
        && data().keys().hasOnly(['uid', 'name', 'location', 'active', 'expiresAt', 'createdAt', 'updatedAt'])
        && data().uid == request.auth.uid
        && isText(data().name, 1, 40)
        && validLocation()
        && data().active == true
        && data().createdAt == request.time
        && data().updatedAt == request.time
        && data().expiresAt is timestamp
        && data().expiresAt > request.time
        && data().expiresAt <= request.time + duration.value(4, 'h')
        && token.size() >= 20;

      // Solo quien la creó: mover el punto o detenerla. No puede alargar el tiempo.
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && onlyChanges(['location', 'active', 'updatedAt'])
        && validLocation()
        && data().active is bool
        && data().updatedAt == request.time
        && request.time < resource.data.expiresAt;

      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------- Reseñas de todos los locales (moderación del admin) ----------
    // Las reseñas son públicas; esta regla permite consultarlas juntas (collection group).
    match /{path=**}/reviews/{reviewUid} {
      allow read: if true;
    }

    // ---------- Registro de acciones de administración (solo servidor) ----------
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------- Todo lo demás: cerrado ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
