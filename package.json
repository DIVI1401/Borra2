{
  "name": "borra2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "emulators": "firebase emulators:start --project demo-borra2 --import=./.emulator-data --export-on-exit",
    "set-role": "tsx --env-file=.env.local scripts/set-role.ts",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "test": "vitest run",
    "test:emu": "firebase emulators:exec --only firestore --project demo-borra2 \"vitest run\"",
    "seed:prod": "tsx --env-file=.env.production.local scripts/seed.ts",
    "set-role:prod": "tsx --env-file=.env.production.local scripts/set-role.ts",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@hookform/resolvers": "^7.0.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "firebase": "^13.3.0",
    "firebase-admin": "^14.5.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "react-leaflet": "^5.0.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "firebase-tools": "^15.36.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "^5.10.0"
    }
  }
}
